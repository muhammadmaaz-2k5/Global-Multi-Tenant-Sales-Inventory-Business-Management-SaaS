{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "REDIS_URL",
        "PORT",
        "NODE_ENV",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "NEXT_PUBLIC_API_URL",
        "CORS_ORIGIN"
      ]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["node_modules/.prisma/**"]
    },
    "push": {
      "dependsOn": ["^push"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
